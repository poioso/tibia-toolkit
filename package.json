{
  "name": "tibia-toolkit",
  "productName": "Tibia Toolkit",
  "version": "0.7.0",
  "author": "Tibia Toolkit",
  "license": "GPL-3.0-only",
  "description": "App desktop overlay Tibia Toolkit para consultar precos de Tibia.",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "start:overlay": "electron .",
    "test": "node tools/run-release-tests.mjs",
    "check": "node tools/verify-public-source.mjs",
    "test:updater": "node --test tools/updater-contract.test.mjs",
    "test:negative-runtime-audits": "node tools/test-negative-runtime-audits.mjs",
    "audit:runtime-dependencies": "node tools/audit-runtime-dependencies.mjs",
    "build:native-host": "dotnet publish desktop/screen-vision-native/ScreenVision.NativeHost/ScreenVision.NativeHost.csproj -c Release -r win-x64 --self-contained true -o desktop/screen-vision-native/publish/win-x64 --nologo",
    "build:content-pack": "node tools/build-content-pack.mjs",
    "generate:content-contract": "node tools/generate-content-pack-contract.mjs",
    "verify:content-contract": "node tools/verify-content-pack-contract.mjs",
    "audit:runtime-assets": "node tools/audit-app-runtime-assets.mjs",
    "audit:content-pack": "node tools/audit-content-pack.mjs",
    "build:installer": "node desktop/build-installer.mjs",
    "test:assisted-installer": "node tools/test-assisted-installer.mjs",
    "verify:packaged-runtime": "node tools/verify-packaged-runtime.mjs",
    "verify:packaged-runtime-modules": "node tools/verify-packaged-runtime-modules.mjs",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "devDependencies": {
    "cheerio": "^1.1.2",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "google-translate-api-x": "^10.7.3",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "driver.js": "^1.6.0",
    "electron-updater": "^6.8.9",
    "jquery": "^3.7.1",
    "leaflet": "^1.9.4",
    "obs-websocket-js": "^5.0.8",
    "playwright": "^1.61.1"
  }
}
