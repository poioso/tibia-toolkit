{
  "appId": "com.poioso.tibia-toolkit.portable-test",
  "productName": "Tibia Toolkit Portable",
  "directories": {
    "output": ".local/build/portable-test/electron",
    "buildResources": "desktop/build"
  },
  "asar": false,
  "files": [
    "package.json",
    "index.html",
    "app.js",
    "styles.css",
    "desktop/*.js",
    "desktop/*.cjs",
    "desktop/*.html",
    "desktop/*.css",
    "desktop/app-config.json",
    "desktop/config/**/*.js",
    "desktop/obs-integration/**/*.js",
    "desktop/screen-vision/**/*",
    "desktop/side-panel/**/*",
    "desktop/build/icon.ico",
    "desktop/build/bootstrap/**/*",
    "lib/**/*",
    "!desktop/auth-homologation.local.json",
    "!desktop/app-config.example.json",
    "!desktop/build-installer.mjs",
    "!desktop/main.corrupted-*.js",
    "!desktop/electron-builder*.json",
    "!desktop/screen-vision-native/**/*",
    "!desktop/tibia-screenshot-capture/**/*",
    "!desktop/vps-checker/**/*",
    "!**/*.local.*",
    "!**/.env*",
    "!**/*.log",
    "!**/*.map",
    "!**/*.pdb",
    "!**/*.db",
    "!**/*.sqlite*",
    "!**/*ACESSOS*",
    "!**/*PRIVATE*",
    "!**/*SECRET*"
  ],
  "win": {
    "icon": "desktop/build/icon.ico",
    "executableName": "Tibia Toolkit Portable",
    "signAndEditExecutable": false
  }
}
