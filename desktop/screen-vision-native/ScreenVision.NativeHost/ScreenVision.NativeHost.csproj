<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenVision.NativeHost</AssemblyName>
    <RootNamespace>ScreenVision.NativeHost</RootNamespace>
    <!-- Keep the technical executable name because Electron and the installer
         use it to locate/stop the helper, but expose the product identity in
         Windows surfaces such as Volume Mixer and Task Manager. -->
    <AssemblyTitle>Tibia Toolkit</AssemblyTitle>
    <Product>Tibia Toolkit</Product>
    <Company>Tibia Toolkit</Company>
    <Description>Tibia Toolkit audio and overlay service</Description>
    <ApplicationIcon>..\..\build\icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The selector runs from a self-contained native host. Embed its controls
         so thin/content-pack installs cannot lose the confirm/cancel images. -->
    <Resource Include="Assets\selector\*.png" />
    <Content Include="Assets\**\*" Exclude="Assets\selector\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
